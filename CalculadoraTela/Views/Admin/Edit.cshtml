@model CalculadoraTela.ViewModels.AdminEditUserViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container-fluid py-4 px-3 px-md-4" style="min-height:100vh;">

    <div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom:2px solid #dde3ec;">
        <div class="d-flex align-items-center justify-content-center rounded-3 text-white shadow"
             style="background:linear-gradient(135deg,#1d4ed8,#2563eb); width:48px; height:48px; flex-shrink:0;">
            <i class="bi bi-pencil-fill fs-5"></i>
        </div>
        <div>
            <h2 class="fw-black mb-0" style="color:#0b1629; letter-spacing:-0.5px;">Editar usuario</h2>
            <span class="small fw-medium" style="color:#64748b;">@Model.UserName</span>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-6 col-xl-5">
            <div class="card border-0 p-4" style="border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.08);">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <form asp-controller="Admin" asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="fw-semibold small" style="color:#334155;"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person-vcard-fill text-secondary"></i></span>
                            <input asp-for="NombreCompleto" class="form-control" />
                        </div>
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="fw-semibold small" style="color:#334155;"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person-fill text-secondary"></i></span>
                            <input asp-for="UserName" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="fw-semibold small" style="color:#334155;"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope-fill text-secondary"></i></span>
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="EsAdministrador" class="form-check-input" />
                        <label asp-for="EsAdministrador" class="form-check-label small text-secondary fw-normal"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn fw-semibold text-white border-0" style="background:linear-gradient(135deg,#1d4ed8,#2563eb); border-radius:10px; padding:11px 24px;">
                            <i class="bi bi-check-circle-fill me-1"></i> Guardar cambios
                        </button>
                        <a asp-controller="Admin" asp-action="Index" class="btn fw-semibold" style="background:#f1f5f9; color:#334155; border-radius:10px; padding:11px 24px;">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
