@model List<CalculadoraTela.ViewModels.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Administración de usuarios";
}

<div class="container-fluid py-4 px-3 px-md-4" style="min-height:100vh;">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 gap-3"
         style="border-bottom:2px solid #dde3ec;">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-icon-box d-flex align-items-center justify-content-center rounded-3 text-white"
                 style="width:48px; height:48px; flex-shrink:0;">
                <i class="bi bi-people-fill fs-5"></i>
            </div>
            <div>
                <h2 class="fw-black mb-0" style="color:#0b1629; letter-spacing:-0.5px;">Administración de usuarios</h2>
                <span class="small fw-medium" style="color:#64748b;">@Model.Count usuario(s) registrado(s)</span>
            </div>
        </div>
        <a asp-controller="Admin" asp-action="Create"
           class="admin-btn-nuevo btn fw-semibold rounded-pill px-4 text-white border-0">
            <i class="bi bi-person-plus-fill me-1"></i>Nuevo usuario
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success py-2 px-3 small mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i> @TempData["Mensaje"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 small mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card admin-card border-0 mb-4">
            <div class="text-center py-5" style="color:#94a3b8;">No hay usuarios registrados todavía.</div>
        </div>
    }
    else
    {
        <!-- ══════ Vista de tabla (escritorio / tablet) ══════ -->
        <div class="card admin-card border-0 mb-4 d-none d-md-block">
            <div class="table-responsive">
                <table class="table admin-table table-hover align-middle mb-0" style="font-size:0.85rem; min-width:900px;">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre completo</th>
                            <th>Correo</th>
                            <th>Registrado</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var iniciales = string.Concat((u.UserName ?? "?").Take(2)).ToUpper();
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="admin-avatar">@iniciales</div>
                                        <span class="admin-user-name">@u.UserName</span>
                                    </div>
                                </td>
                                <td><span class="admin-fullname">@u.NombreCompleto</span></td>
                                <td><span class="admin-email">@u.Email</span></td>
                                <td><span class="admin-meta">@u.FechaRegistro.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    @if (u.EsAdministrador)
                                    {
                                        <span class="admin-badge admin-badge-admin">
                                            <i class="bi bi-shield-fill-check"></i>Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-user">
                                            <i class="bi bi-person-fill"></i>Usuario
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (u.Suspendido)
                                    {
                                        <span class="admin-badge admin-badge-suspended">
                                            <i class="bi bi-slash-circle-fill"></i>Suspendido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-active">
                                            <i class="bi bi-check-circle-fill"></i>Activo
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@u.Id"
                                           class="admin-action-btn admin-action-edit" title="Editar usuario">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="ChangePassword" asp-route-id="@u.Id"
                                           class="admin-action-btn admin-action-password" title="Cambiar contraseña">
                                            <i class="bi bi-key-fill"></i>
                                        </a>
                                        <form asp-controller="Admin" asp-action="ForzarCierreSesion" method="post" class="mb-0"
                                              onsubmit="return confirm('¿Cerrar la sesión activa de @u.UserName?');">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="admin-action-btn admin-action-logout border-0" title="Forzar cierre de sesión">
                                                <i class="bi bi-power"></i>
                                            </button>
                                        </form>
                                        @if (u.Suspendido)
                                        {
                                            <form asp-controller="Admin" asp-action="Reactivar" method="post" class="mb-0"
                                                  onsubmit="return confirm('¿Reactivar a @u.UserName?');">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="admin-action-btn admin-action-reactivate border-0" title="Reactivar usuario">
                                                    <i class="bi bi-play-circle-fill"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin" asp-action="Suspender" method="post" class="mb-0"
                                                  onsubmit="return confirm('¿Suspender a @u.UserName? No podrá iniciar sesión hasta que lo reactives.');">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="admin-action-btn admin-action-suspend border-0" title="Suspender usuario">
                                                    <i class="bi bi-slash-circle-fill"></i>
                                                </button>
                                            </form>
                                        }
                                        <form asp-controller="Admin" asp-action="Delete" method="post" class="mb-0"
                                              onsubmit="return confirm('¿Eliminar al usuario @u.UserName? Esta acción no se puede deshacer.');">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="admin-action-btn admin-action-delete border-0" title="Eliminar usuario">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ══════ Vista de tarjetas apiladas (móvil) ══════ -->
        <div class="d-md-none d-flex flex-column gap-3 mb-4">
            @foreach (var u in Model)
            {
                var iniciales = string.Concat((u.UserName ?? "?").Take(2)).ToUpper();
                <div class="admin-mobile-card">
                    <div class="admin-mobile-header">
                        <div class="admin-avatar">@iniciales</div>
                        <div class="flex-grow-1">
                            <div class="admin-mobile-username">@u.UserName</div>
                        </div>
                        @if (u.EsAdministrador)
                        {
                            <span class="admin-badge admin-badge-admin"><i class="bi bi-shield-fill-check"></i>Admin</span>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge-user"><i class="bi bi-person-fill"></i>Usuario</span>
                        }
                    </div>
                    <div class="admin-mobile-body">
                        <div class="admin-mobile-row">
                            <span class="admin-mobile-label">Nombre completo</span>
                            <span class="admin-mobile-value">@u.NombreCompleto</span>
                        </div>
                        <div class="admin-mobile-row">
                            <span class="admin-mobile-label">Correo</span>
                            <span class="admin-mobile-value">@u.Email</span>
                        </div>
                        <div class="admin-mobile-row">
                            <span class="admin-mobile-label">Registrado</span>
                            <span class="admin-mobile-value">@u.FechaRegistro.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="admin-mobile-row">
                            <span class="admin-mobile-label">Estado</span>
                            @if (u.Suspendido)
                            {
                                <span class="admin-badge admin-badge-suspended"><i class="bi bi-slash-circle-fill"></i>Suspendido</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-active"><i class="bi bi-check-circle-fill"></i>Activo</span>
                            }
                        </div>
                    </div>
                    <div class="admin-mobile-actions">
                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@u.Id"
                           class="admin-action-btn admin-action-edit">
                            <i class="bi bi-pencil-fill"></i>Editar
                        </a>
                        <a asp-controller="Admin" asp-action="ChangePassword" asp-route-id="@u.Id"
                           class="admin-action-btn admin-action-password">
                            <i class="bi bi-key-fill"></i>Contraseña
                        </a>
                        <form asp-controller="Admin" asp-action="ForzarCierreSesion" method="post"
                              onsubmit="return confirm('¿Cerrar la sesión activa de @u.UserName?');">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="admin-action-btn admin-action-logout border-0">
                                <i class="bi bi-power"></i>Cerrar sesión
                            </button>
                        </form>
                        @if (u.Suspendido)
                        {
                            <form asp-controller="Admin" asp-action="Reactivar" method="post"
                                  onsubmit="return confirm('¿Reactivar a @u.UserName?');">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="admin-action-btn admin-action-reactivate border-0">
                                    <i class="bi bi-play-circle-fill"></i>Reactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="Suspender" method="post"
                                  onsubmit="return confirm('¿Suspender a @u.UserName? No podrá iniciar sesión hasta que lo reactives.');">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="admin-action-btn admin-action-suspend border-0">
                                    <i class="bi bi-slash-circle-fill"></i>Suspender
                                </button>
                            </form>
                        }
                        <form asp-controller="Admin" asp-action="Delete" method="post"
                              onsubmit="return confirm('¿Eliminar al usuario @u.UserName? Esta acción no se puede deshacer.');">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="admin-action-btn admin-action-delete border-0">
                                <i class="bi bi-trash3"></i>Eliminar
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <p class="small text-secondary">
        <i class="bi bi-info-circle me-1"></i>
        <i class="bi bi-power"></i> corta la sesión activa sin bloquear la cuenta &nbsp;|&nbsp;
        <i class="bi bi-slash-circle-fill"></i> suspende la cuenta por completo (no podrá iniciar sesión hasta reactivarla).
    </p>

</div>
