@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
         style="width:64px; height:64px; background:#fef2f2; color:#dc2626;">
        <i class="bi bi-shield-lock-fill fs-2"></i>
    </div>
    <h1>Acceso denegado</h1>
    <p class="auth-subtitle">No tienes permisos para ver esta página.</p>

    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ir a iniciar sesión
    </a>
</div>
