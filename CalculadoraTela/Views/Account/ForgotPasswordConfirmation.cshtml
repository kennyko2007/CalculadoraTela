@{
    ViewData["Title"] = "Revisa tu correo";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
         style="width:64px; height:64px; background:#eff6ff; color:#2563eb;">
        <i class="bi bi-envelope-check-fill fs-2"></i>
    </div>
    <h1>Revisa tu correo</h1>
    <p class="small text-secondary mt-2">
        Si el correo que ingresaste está registrado y confirmado, te enviamos un enlace
        para restablecer tu contraseña. Revisa tu bandeja de entrada (y la carpeta de SPAM).
    </p>

    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ir a iniciar sesión
    </a>
</div>
