@model CalculadoraTela.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<h1>¿Olvidaste tu contraseña?</h1>
<p class="auth-subtitle">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">

    <div class="mb-4">
        <label asp-for="Email"></label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope-fill text-secondary"></i></span>
            <input asp-for="Email" class="form-control" autocomplete="email" autofocus placeholder="tucorreo@gmail.com" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-auth-primary w-100">
        <i class="bi bi-send-fill me-1"></i> Enviar enlace de recuperación
    </button>
</form>

<div class="auth-footer-link">
    <a asp-controller="Account" asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
