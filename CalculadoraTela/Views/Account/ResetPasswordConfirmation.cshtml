@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
         style="width:64px; height:64px; background:#ecfdf5; color:#059669;">
        <i class="bi bi-check-circle-fill fs-2"></i>
    </div>
    <h1>¡Contraseña actualizada!</h1>
    <p class="small text-secondary mt-2">
        Tu contraseña se restableció correctamente. Ya puedes iniciar sesión con tu nueva contraseña.
    </p>

    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ir a iniciar sesión
    </a>
</div>
