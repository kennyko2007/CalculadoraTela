@{
    ViewData["Title"] = "Confirmación de correo";
    Layout = "_AuthLayout";
    bool exito = ViewBag.Exito == true;
}

<div class="text-center">
    @if (exito)
    {
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
             style="width:64px; height:64px; background:#ecfdf5; color:#059669;">
            <i class="bi bi-check-circle-fill fs-2"></i>
        </div>
        <h1>¡Correo confirmado!</h1>
        <p class="auth-subtitle">Tu cuenta ya está activa. Ya puedes iniciar sesión.</p>
    }
    else
    {
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
             style="width:64px; height:64px; background:#fef2f2; color:#dc2626;">
            <i class="bi bi-x-circle-fill fs-2"></i>
        </div>
        <h1>No pudimos confirmar tu correo</h1>
        <p class="auth-subtitle">El enlace no es válido o ya expiró. Intenta registrarte de nuevo o contacta al administrador.</p>
    }

    <a asp-controller="Account" asp-action="Login" class="btn btn-auth-primary w-100 mt-3">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ir a iniciar sesión
    </a>
</div>
