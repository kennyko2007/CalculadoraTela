@model CalculadoraTela.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<h1>Iniciar sesión</h1>
<p class="auth-subtitle">Ingresa con tu usuario y contraseña para continuar.</p>

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success py-2 px-3 small mb-3">@TempData["Mensaje"]</div>
}

<form asp-controller="Account" asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="UserName"></label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-person-fill text-secondary"></i></span>
            <input asp-for="UserName" class="form-control" autocomplete="username" autofocus placeholder="Tu usuario" />
        </div>
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password"></label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-lock-fill text-secondary"></i></span>
            <input asp-for="Password" id="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="Password" tabindex="-1" aria-label="Mostrar contraseña">
                <i class="bi bi-eye-fill"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
        <div class="text-end mt-1">
            <a asp-controller="Account" asp-action="ForgotPassword" class="small text-decoration-none">¿Olvidaste tu contraseña?</a>
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RecordarSesion" class="form-check-input" />
        <label asp-for="RecordarSesion" class="form-check-label small text-secondary fw-normal"></label>
    </div>

    <button type="submit" class="btn btn-auth-primary w-100">
        <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
    </button>
</form>

<div class="auth-footer-link">
    ¿No tienes cuenta? <a asp-controller="Account" asp-action="Register">Regístrate</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/toggle-password.js"></script>
}
